/*
SQL code challenge: customer postal code transformation
write a query that selects the customers full name and transforms their postal code into a standardized 5-digit format

*/

SELECT
	c.FirstName ||' '|| c.LastName as CustomerFullName,
	--length(postalcode),  -- not same value, will need to add an additional code take a differant approch
	substr(c.postalcode, 1,5) as [StandardizedPostalCode]
FROM
	Customer as c
WHERE
	Country = 'USA'
order by 
	CustomerFullName;
























