/*
Training, Code Challenge: Analyzing customer support interactions
Description: write query to generate report that lists each customer along with their assigned support Report rep.
*/

SELECT
	c.FirstName as CustomerFirstName,
	c.LastName as CustomerLastName,
	e.FirstName as SupportRepFirstName,
	e.LastName as SupportRepLastName
	
FROM
	customer as c
INNER JOIN
	Employee as e
on 
	c.SupportRepId = e.EmployeeId
	





































